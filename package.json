{
  "name": "pyre-code",
  "version": "1.0.0",
  "description": "LeetCode-style ML coding problems \u2014 implement PyTorch modules from scratch",
  "license": "MIT",
  "author": "kiren",
  "repository": {
    "type": "git",
    "url": "https://github.com/BGWH123/Ember"
  },
  "scripts": {
    "postinstall": "npm --prefix apps/desktop ci",
    "build:problems": "node scripts/run-python.js scripts/export_problems.py",
    "build:solutions": "node scripts/run-python.js scripts/build_solutions.py",
    "build:starters": "node scripts/run-python.js scripts/build_starters.py",
    "import:handbook": "node scripts/import-handbook.mjs",
    "dev": "npm --prefix apps/desktop run tauri -- dev",
    "build:desktop": "npm --prefix apps/desktop run tauri -- build",
    "build:windows": "npm --prefix apps/desktop run tauri -- build --bundles msi,nsis",
    "build:macos": "npm --prefix apps/desktop run tauri -- build --bundles app,dmg",
    "build:macos:universal": "npm --prefix apps/desktop run tauri -- build --bundles app,dmg --target universal-apple-darwin",
    "build:desktop:release": "node scripts/desktop/build-release.mjs",
    "check:core": "cargo test -p ember-core -p ember-evaluator",
    "build:ui": "npm --prefix apps/desktop run build",
    "docs:install": "npm --prefix docs ci",
    "docs:dev": "npm --prefix docs run dev",
    "docs:check": "npm --prefix docs run check",
    "test:python": "node scripts/run-python.js -m pytest modules/evaluator tests -q"
  },
  "devDependencies": {}
}
