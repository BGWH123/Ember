{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember",
  "version": "0.1.0",
  "identifier": "dev.ember.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ember \u2014 AI Systems Lab",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../content/catalog/problems.json": "catalog/problems.json",
      "../../../content/catalog/starters.json": "catalog/starters.json",
      "../../../content/catalog/solutions.json": "catalog/solutions.json",
      "../../../content/catalog/paths.json": "catalog/paths.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
